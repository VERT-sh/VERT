		"@mediabunny/prores": "^1.61.3",
		"@stripe/stripe-js": "^10.0.0",
		"@types/node": "24",
		"byte-data": "^19.0.1",
		"client-zip": "^2.5.1",
		"clsx": "^2.1.1",
		"dicom.ts": "^1.3.0",
		"fflate": "^0.8.3",
		"file-type": "^22.1.1",
