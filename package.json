{
	"name": "vert",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migrate:messages": "node scripts/migrate-language-keys.mjs",
		"format": "prettier --write .",
		"lint": "eslint ."
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.26.0",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^9.6.1",
		"@types/sanitize-html": "^2.16.2",
		"autoprefixer": "^10.6.1",
		"css-select": "5.1.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sass": "^1.105.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vite-plugin-top-level-await": "^1.6.0"
	},
	"dependencies": {
		"@bjorn3/browser_wasi_shim": "^0.4.2",
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@fontsource/azeret-mono": "^5.3.0",
		"@fontsource/lexend": "^5.3.0",
		"@fontsource/radio-canada-big": "^5.3.0",
		"@imagemagick/magick-wasm": "^0.0.44",
